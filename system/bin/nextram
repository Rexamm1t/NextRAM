#!/system/bin/sh

MODDIR="/data/adb/modules/NextRAM"
CONFIG_FILE="$MODDIR/config.conf"
LOG_FILE="$MODDIR/nextram.log"
AI_MODEL_FILE="$MODDIR/ai_model.dat"
METRICS_REPORT_DIR="$MODDIR/reports"

SUCCESS=0
INVALID_ARG=1
MISSING_ARG=2
INVALID_VALUE=3
FILE_MISSING=4
DEPENDENCY_MISSING=5
OPERATION_FAILED=6

log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

validate_number() {
    if ! echo "$1" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        echo "ERROR: '$1' is not a valid number."
        exit $INVALID_VALUE
    fi
}

validate_integer() {
    if ! echo "$1" | grep -qE '^[0-9]+$'; then
        echo "ERROR: '$1' is not a valid integer."
        exit $INVALID_VALUE
    fi
}

validate_range() {
    validate_number "$1"
    if [ "$(echo "$1 < $2" | bc -l)" -eq 1 ] || [ "$(echo "$1 > $3" | bc -l)" -eq 1 ]; then
        echo "ERROR: Value must be between $2 and $3."
        exit $INVALID_VALUE
    fi
}

validate_swappiness() {
    validate_range "$1" 0 100
}

validate_algorithm() {
    if [ -b "/dev/block/zram0" ] && [ -f "/sys/block/zram0/comp_algorithm" ]; then
        AVAILABLE_ALGS=$(cat /sys/block/zram0/comp_algorithm | sed 's/\[//g;s/\]//g')
        if ! echo "$AVAILABLE_ALGS" | grep -qw "$1"; then
            echo "ERROR: Algorithm '$1' is not available."
            echo "Available algorithms: $AVAILABLE_ALGS"
            exit $INVALID_VALUE
        fi
    else
        echo "WARNING: Cannot verify algorithm availability. ZRAM device not accessible."
    fi
}

check_dependencies() {
    local deps="grep sed cat bc"
    for dep in $deps; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo "ERROR: Dependency '$dep' not found."
            exit $DEPENDENCY_MISSING
        fi
    done
}

set_config() {
    local key="$1"
    local value="$2"
    
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "ERROR: Configuration file not found."
        exit $FILE_MISSING
    fi
    
    cp "$CONFIG_FILE" "$CONFIG_FILE.bak" 2>/dev/null
    
    if grep -q "^$key=" "$CONFIG_FILE"; then
        sed -i "s/^$key=.*/$key=$value/" "$CONFIG_FILE"
    else
        echo "$key=$value" >> "$CONFIG_FILE"
    fi
    
    if [ $? -ne 0 ]; then
        echo "ERROR: Failed to update configuration."
        mv "$CONFIG_FILE.bak" "$CONFIG_FILE" 2>/dev/null
        exit $OPERATION_FAILED
    fi
    
    log_message "Config changed: $key=$value"
}

get_config() {
    grep -E "^$1=" "$CONFIG_FILE" | cut -d= -f2
}

confirm_action() {
    local action="$1"
    echo "WARNING: $action"
    printf "Are you sure you want to continue? (y/N): "
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY])
            return 0
            ;;
        *)
            echo "Operation cancelled."
            exit $SUCCESS
            ;;
    esac
}

show_status() {
    echo "    \  |               |     _ \      \      \  |  by "
    echo "     \ |   _ \ \ \  /  __|  |   |    _ \    |\/ |  "
    echo "   |\  |   __/  \  <   |    __ <    ___ \   |   |  @rexamm1t"
    echo "  _| \_| \___|  _/\_\ \__| _| \_\ _/    _\ _|  _|  @matrix_5858"
    echo " "
    echo "=== Basic Settings ==="
    echo "Swap: $( [ "$(get_config SWAP_ENABLED)" = "true" ] && echo "Enabled ($(get_config SWAP_SIZE_GB)GB)" || echo "Disabled" )"
    echo "Swap Overhead: $(get_config OVERHEAD_GB)GB"
    echo "ZRAM: $( [ "$(get_config ZRAM_ENABLED)" = "true" ] && echo "Enabled (Ratio: $(get_config ZRAM_RATIO))" || echo "Disabled" )"
    echo "ZRAM Algorithm: $(get_config ZRAM_ALGORITHM)"
    echo "Max Compression Streams: $(get_config MAX_COMP_STREAMS)"
    echo "Swappiness: $(get_config SWAPPINESS)"
    echo "Cache Pressure: $(get_config CACHE_PRESSURE)"
    echo "Dirty Ratio: $(get_config DIRTY_RATIO)"
    echo "Dirty Background Ratio: $(get_config DIRTY_BACKGROUND_RATIO)"
    
    echo " "
    echo "=== Advanced Features ==="
    echo "Performance Profile: $(get_config PERFORMANCE_PROFILE)"
    echo "AI Optimizer: $(get_config AI_OPTIMIZER_ENABLED)"
    echo "Thermal Control: $(get_config THERMAL_CONTROL_ENABLED)"
    echo "Process Aware: $(get_config PROCESS_AWARE_OPTIMIZATION)"
    echo "Context Aware: $(get_config CONTEXT_AWARE_OPTIMIZATION)"
    echo "Extra Tuning: $(get_config EXTRA_TUNING)"
    echo "Dynamic Swappiness: $(get_config DYNAMIC_SWAPPINESS)"
    echo "Performance Mode: $(get_config PERFORMANCE_MODE)"
    echo "ZRAM Auto Tune: $(get_config ZRAM_AUTO_TUNE)"
    
    echo " "
    echo "=== System Info ==="
    echo "Config file: $CONFIG_FILE"
    echo "Log file: $LOG_FILE"
    echo "AI Model: $AI_MODEL_FILE"
    echo "Reports: $METRICS_REPORT_DIR"
}

show_available_algorithms() {
    if [ -b "/dev/block/zram0" ] && [ -f "/sys/block/zram0/comp_algorithm" ]; then
        echo "Available ZRAM compression algorithms:"
        AVAILABLE_ALGS=$(cat /sys/block/zram0/comp_algorithm | sed 's/\[//g;s/\]//g')
        CURRENT_ALG=$(get_config ZRAM_ALGORITHM)
        for ALG in $AVAILABLE_ALGS; do
            if [ "$ALG" = "$CURRENT_ALG" ]; then
                echo "  $ALG (current)"
            else
                echo "  $ALG"
            fi
        done
    else
        echo "ERROR: ZRAM device not available. Cannot check algorithms."
        exit $OPERATION_FAILED
    fi
}

show_performance_apps() {
    local apps=$(get_config PERFORMANCE_APPS)
    echo "Performance Apps:"
    if [ -n "$apps" ]; then
        echo "$apps" | tr ',' '\n' | while read app; do
            echo "  $app"
        done
    else
        echo "  None configured"
    fi
}

show_background_apps() {
    local apps=$(get_config BACKGROUND_APPS)
    echo "Background Apps:"
    if [ -n "$apps" ]; then
        echo "$apps" | tr ',' '\n' | while read app; do
            echo "  $app"
        done
    else
        echo "  None configured"
    fi
}

add_performance_app() {
    local app="$1"
    local current=$(get_config PERFORMANCE_APPS)
    if [ -z "$current" ]; then
        set_config PERFORMANCE_APPS "$app"
    else
        if echo ",$current," | grep -q ",$app,"; then
            echo "App '$app' is already in performance list."
        else
            set_config PERFORMANCE_APPS "$current,$app"
        fi
    fi
    echo "Added '$app' to performance apps."
}

remove_performance_app() {
    local app="$1"
    local current=$(get_config PERFORMANCE_APPS)
    if [ -n "$current" ]; then
        local new_list=$(echo "$current" | sed "s/,$app//g; s/^$app,//; s/,$app$//; s/^$app$//")
        set_config PERFORMANCE_APPS "$new_list"
        echo "Removed '$app' from performance apps."
    else
        echo "No performance apps configured."
    fi
}

add_background_app() {
    local app="$1"
    local current=$(get_config BACKGROUND_APPS)
    if [ -z "$current" ]; then
        set_config BACKGROUND_APPS "$app"
    else
        if echo ",$current," | grep -q ",$app,"; then
            echo "App '$app' is already in background list."
        else
            set_config BACKGROUND_APPS "$current,$app"
        fi
    fi
    echo "Added '$app' to background apps."
}

remove_background_app() {
    local app="$1"
    local current=$(get_config BACKGROUND_APPS)
    if [ -n "$current" ]; then
        local new_list=$(echo "$current" | sed "s/,$app//g; s/^$app,//; s/,$app$//; s/^$app$//")
        set_config BACKGROUND_APPS "$new_list"
        echo "Removed '$app' from background apps."
    else
        echo "No background apps configured."
    fi
}

generate_metrics_report() {
    local report_file="$METRICS_REPORT_DIR/metrics_report_$(date +%Y%m%d_%H%M%S).txt"
    mkdir -p "$METRICS_REPORT_DIR"
    
    echo "Generating metrics report..."
    echo "=== NextRAM Metrics Report ===" > "$report_file"
    echo "Generated: $(date)" >> "$report_file"
    echo " " >> "$report_file"
    
    echo "=== System Information ===" >> "$report_file"
    cat /proc/meminfo | grep -E "MemTotal|MemFree|MemAvailable|SwapTotal|SwapFree" >> "$report_file"
    echo " " >> "$report_file"
    
    if [ -b "/dev/block/zram0" ]; then
        echo "=== ZRAM Information ===" >> "$report_file"
        cat /sys/block/zram0/mm_stat 2>/dev/null >> "$report_file"
        echo " " >> "$report_file"
    fi
    
    echo "=== VM Settings ===" >> "$report_file"
    for setting in swappiness cache_pressure dirty_ratio dirty_background_ratio; do
        value=$(cat /proc/sys/vm/$setting 2>/dev/null || echo "N/A")
        echo "$setting: $value" >> "$report_file"
    done
    echo " " >> "$report_file"
    
    echo "Report generated: $report_file"
    log_message "Metrics report generated: $report_file"
}

show_ai_status() {
    if [ -f "$AI_MODEL_FILE" ]; then
        echo "AI Optimizer: Trained ($(stat -c %y "$AI_MODEL_FILE"))"
        echo "Patterns learned: $(wc -l < "$AI_MODEL_FILE" 2>/dev/null || echo "0")"
    else
        echo "AI Optimizer: Not trained"
    fi
}

train_ai_model() {
    echo "Starting AI model training..."
    log_message "AI training initiated"
    echo "AI model training started. Check logs for progress."
}

show_help() {
    echo " "
    echo "        \  |               |     _ \      \      \  |  by "
    echo "         \ |   _ \ \ \  /  __|  |   |    _ \    |\/ |  "
    echo "       |\  |   __/  \  <   |    __ <    ___ \   |   |  @rexamm1t"
    echo "      _| \_| \___|  _/\_\ \__| _| \_\ _/    _\ _|  _|  @matrix_5858"
    echo " "
    echo "                    === NextRAM Commands ==="
    echo " "
    echo "                      --Attention!--"
    echo "The <value> may contain (for example): 1, 3.3, 4.1. or lz4, zstd..."
    echo "All size values are in gigabytes."
    echo "To select the compression algorithm, look at the available ones first)"
    echo " "
    echo "=== Basic Commands ==="
    echo "nextram -status                          Show current status"
    echo "nextram -swap -on                        Enable swap"
    echo "nextram -swap -off                       Disable swap"
    echo "nextram -swap -size <value>              Set swap size in GB"
    echo "nextram -swap -over <value>              Set swap overhead in GB"
    echo "nextram -zram -on                        Enable ZRAM"
    echo "nextram -zram -off                       Disable ZRAM"
    echo "nextram -zram -alg                       Show available compression algorithms"
    echo "nextram -zram -ratio <value>             Set ZRAM ratio"
    echo "nextram -zram -algo <value>              Set compression algorithm"
    echo "nextram -zram -str <value>               Set compression streams"
    echo "nextram -vm -swap <value>                Set swappiness (0-100)"
    echo "nextram -vm -cache <value>               Set cache pressure"
    echo "nextram -vm -dirty <value>               Set dirty ratio (0-100)"
    echo "nextram -vm -dirtybg <value>             Set dirty background ratio (0-100)"
    echo " "
    echo "=== Advanced Features ==="
    echo "nextram -tuning -on                      Enable extra tuning"
    echo "nextram -tuning -off                     Disable extra tuning"
    echo "nextram -dyn -on                         Enable dynamic swappiness"
    echo "nextram -dyn -off                        Disable dynamic swappiness"
    echo "nextram -perf -on                        Enable performance mode"
    echo "nextram -perf -off                       Disable performance mode"
    echo "nextram -zauto -on                       Enable ZRAM auto tuning"
    echo "nextram -zauto -off                      Disable ZRAM auto tuning"
    echo " "
    echo "=== AI & Smart Features ==="
    echo "nextram -ai -on                          Enable AI optimizer"
    echo "nextram -ai -off                         Disable AI optimizer"
    echo "nextram -ai -status                      Show AI status"
    echo "nextram -ai -train                       Train AI model"
    echo "nextram -thermal -on                     Enable thermal control"
    echo "nextram -thermal -off                    Disable thermal control"
    echo "nextram -process -on                     Enable process-aware optimization"
    echo "nextram -process -off                    Disable process-aware optimization"
    echo "nextram -context -on                     Enable context-aware optimization"
    echo "nextram -context -off                    Disable context-aware optimization"
    echo " "
    echo "=== Performance Profiles ==="
    echo "nextram -profile -battery                Battery saver profile"
    echo "nextram -profile -balanced               Balanced profile (default)"
    echo "nextram -profile -performance            Performance profile"
    echo "nextram -profile -gaming                 Gaming profile"
    echo "nextram -profile -multitask              Multitasking profile"
    echo "nextram -profile -auto                   Auto-detect profile"
    echo " "
    echo "=== Application Management ==="
    echo "nextram -apps -perf                      Show performance apps"
    echo "nextram -apps -bg                        Show background apps"
    echo "nextram -apps -add -perf <app>           Add app to performance list"
    echo "nextram -apps -remove -perf <app>        Remove app from performance list"
    echo "nextram -apps -add -bg <app>             Add app to background list"
    echo "nextram -apps -remove -bg <app>          Remove app from background list"
    echo " "
    echo "=== Monitoring & Reports ==="
    echo "nextram -metrics                         Show detailed metrics"
    echo "nextram -report                          Generate metrics report"
    echo "nextram -log                             Show log file"
    echo "nextram -help                            Show this help"
    echo " "
    echo "    --After each action, you need to restart the device--  "
    echo " "
}

show_log() {
    if [ -f "$LOG_FILE" ]; then
        echo "=== Last 100 log entries ==="
        tail -100 "$LOG_FILE"
    else
        echo "Log file does not exist yet."
    fi
}

show_detailed_metrics() {
    echo "=== NextRAM Detailed Metrics ==="
    echo "Generated: $(date)"
    echo " "
    
    echo "--- Memory Usage ---"
    cat /proc/meminfo | grep -E "MemTotal|MemFree|MemAvailable|Cached|SwapTotal|SwapFree" | while read line; do
        echo "  $line"
    done
    
    if [ -b "/dev/block/zram0" ]; then
        echo " "
        echo "--- ZRAM Stats ---"
        if [ -f "/sys/block/zram0/mm_stat" ]; then
            mm_stat=$(cat /sys/block/zram0/mm_stat)
            echo "  MM Stat: $mm_stat"
        fi
        if [ -f "/sys/block/zram0/comp_algorithm" ]; then
            alg=$(cat /sys/block/zram0/comp_algorithm)
            echo "  Algorithm: $alg"
        fi
    fi
    
    echo " "
    echo "--- VM Settings ---"
    for setting in swappiness cache_pressure dirty_ratio dirty_background_ratio page-cluster; do
        value=$(cat /proc/sys/vm/$setting 2>/dev/null || echo "N/A")
        echo "  $setting: $value"
    done
    
    echo " "
    echo "--- Top Memory Processes ---"
    ps -o pid,ppid,rss,vsz,pmem,pcpu,comm -A | sort -nrk5 | head -10
}

check_dependencies

case "$1" in
    "-status")
        show_status
        ;;

    "-swap")
        case "$2" in
            "-on")
                set_config SWAP_ENABLED "true"
                echo "Swap enabled. Restart device to apply changes."
                ;;
            "-off")
                confirm_action "Disabling swap may affect system performance."
                set_config SWAP_ENABLED "false"
                echo "Swap disabled. Restart device to apply changes."
                ;;
            "-size")
                if [ -n "$3" ]; then
                    validate_number "$3"
                    set_config SWAP_SIZE_GB "$3"
                    echo "Swap size set to ${3}GB. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -swap -size <size>"
                    exit $MISSING_ARG
                fi
                ;;
            "-over")
                if [ -n "$3" ]; then
                    validate_number "$3"
                    set_config OVERHEAD_GB "$3"
                    echo "Swap overhead set to ${3}GB. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -swap -over <size>"
                    exit $MISSING_ARG
                fi
                ;;
            *)
                echo "ERROR: Usage: nextram -swap [-on | -off | -size <size> | -over <size>]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-zram")
        case "$2" in
            "-on")
                set_config ZRAM_ENABLED "true"
                echo "ZRAM enabled. Restart device to apply changes."
                ;;
            "-off")
                confirm_action "Disabling ZRAM may affect system performance."
                set_config ZRAM_ENABLED "false"
                echo "ZRAM disabled. Restart device to apply changes."
                ;;
            "-alg")
                show_available_algorithms
                ;;
            "-ratio")
                if [ -n "$3" ]; then
                    validate_number "$3"
                    set_config ZRAM_RATIO "$3"
                    echo "ZRAM ratio set to $3. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -zram -ratio <ratio>"
                    exit $MISSING_ARG
                fi
                ;;
            "-algo")
                if [ -n "$3" ]; then
                    validate_algorithm "$3"
                    set_config ZRAM_ALGORITHM "$3"
                    echo "ZRAM algorithm set to $3. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -zram -algo <algorithm>"
                    exit $MISSING_ARG
                fi
                ;;
            "-str")
                if [ -n "$3" ]; then
                    validate_integer "$3"
                    set_config MAX_COMP_STREAMS "$3"
                    echo "ZRAM compression streams set to $3. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -zram -str <streams>"
                    exit $MISSING_ARG
                fi
                ;;
            *)
                echo "ERROR: Usage: nextram -zram [-on | -off | -alg | -ratio <ratio> | -algo <algo> | -str <streams>]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-vm")
        case "$2" in
            "-swap")
                if [ -n "$3" ]; then
                    validate_swappiness "$3"
                    set_config SWAPPINESS "$3"
                    echo "Swappiness set to $3. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -vm -swap <value> (0-100)"
                    exit $MISSING_ARG
                fi
                ;;
            "-cache")
                if [ -n "$3" ]; then
                    validate_number "$3"
                    set_config CACHE_PRESSURE "$3"
                    echo "Cache pressure set to $3. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -vm -cache <value>"
                    exit $MISSING_ARG
                fi
                ;;
            "-dirty")
                if [ -n "$3" ]; then
                    validate_range "$3" 0 100
                    set_config DIRTY_RATIO "$3"
                    echo "Dirty ratio set to $3. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -vm -dirty <value> (0-100)"
                    exit $MISSING_ARG
                fi
                ;;
            "-dirtybg")
                if [ -n "$3" ]; then
                    validate_range "$3" 0 100
                    set_config DIRTY_BACKGROUND_RATIO "$3"
                    echo "Dirty background ratio set to $3. Restart device to apply changes."
                else
                    echo "ERROR: Usage: nextram -vm -dirtybg <value> (0-100)"
                    exit $MISSING_ARG
                fi
                ;;
            *)
                echo "ERROR: Usage: nextram -vm [-swap <value> | -cache <value> | -dirty <value> | -dirtybg <value>]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-tuning")
        case "$2" in
            "-on")
                set_config EXTRA_TUNING "true"
                echo "Extra tuning enabled. Restart device to apply changes."
                ;;
            "-off")
                set_config EXTRA_TUNING "false"
                echo "Extra tuning disabled. Restart device to apply changes."
                ;;
            *)
                echo "ERROR: Usage: nextram -tuning [-on | -off]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-dyn")
        case "$2" in
            "-on")
                set_config DYNAMIC_SWAPPINESS "true"
                echo "Dynamic swappiness enabled. Restart device to apply changes."
                ;;
            "-off")
                set_config DYNAMIC_SWAPPINESS "false"
                echo "Dynamic swappiness disabled. Restart device to apply changes."
                ;;
            *)
                echo "ERROR: Usage: nextram -dyn [-on | -off]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-perf")
        case "$2" in
            "-on")
                set_config PERFORMANCE_MODE "true"
                echo "Performance mode enabled. Restart device to apply changes."
                ;;
            "-off")
                set_config PERFORMANCE_MODE "false"
                echo "Performance mode disabled. Restart device to apply changes."
                ;;
            *)
                echo "ERROR: Usage: nextram -perf [-on | -off]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-zauto")
        case "$2" in
            "-on")
                set_config ZRAM_AUTO_TUNE "true"
                echo "ZRAM auto tuning enabled. Restart device to apply changes."
                ;;
            "-off")
                set_config ZRAM_AUTO_TUNE "false"
                echo "ZRAM auto tuning disabled. Restart device to apply changes."
                ;;
            *)
                echo "ERROR: Usage: nextram -zauto [-on | -off]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-ai")
        case "$2" in
            "-on")
                set_config AI_OPTIMIZER_ENABLED "true"
                echo "AI optimizer enabled. Restart device to apply changes."
                ;;
            "-off")
                set_config AI_OPTIMIZER_ENABLED "false"
                echo "AI optimizer disabled. Restart device to apply changes."
                ;;
            "-status")
                show_ai_status
                ;;
            "-train")
                train_ai_model
                ;;
            *)
                echo "ERROR: Usage: nextram -ai [-on | -off | -status | -train]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-thermal")
        case "$2" in
            "-on")
                set_config THERMAL_CONTROL_ENABLED "true"
                echo "Thermal control enabled. Restart device to apply changes."
                ;;
            "-off")
                set_config THERMAL_CONTROL_ENABLED "false"
                echo "Thermal control disabled. Restart device to apply changes."
                ;;
            *)
                echo "ERROR: Usage: nextram -thermal [-on | -off]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-process")
        case "$2" in
            "-on")
                set_config PROCESS_AWARE_OPTIMIZATION "true"
                echo "Process-aware optimization enabled. Restart device to apply changes."
                ;;
            "-off")
                set_config PROCESS_AWARE_OPTIMIZATION "false"
                echo "Process-aware optimization disabled. Restart device to apply changes."
                ;;
            *)
                echo "ERROR: Usage: nextram -process [-on | -off]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-context")
        case "$2" in
            "-on")
                set_config CONTEXT_AWARE_OPTIMIZATION "true"
                echo "Context-aware optimization enabled. Restart device to apply changes."
                ;;
            "-off")
                set_config CONTEXT_AWARE_OPTIMIZATION "false"
                echo "Context-aware optimization disabled. Restart device to apply changes."
                ;;
            *)
                echo "ERROR: Usage: nextram -context [-on | -off]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-profile")
        case "$2" in
            "-battery")
                set_config PERFORMANCE_PROFILE "battery"
                echo "Battery saver profile set. Restart device to apply changes."
                ;;
            "-balanced")
                set_config PERFORMANCE_PROFILE "balanced"
                echo "Balanced profile set. Restart device to apply changes."
                ;;
            "-performance")
                set_config PERFORMANCE_PROFILE "performance"
                echo "Performance profile set. Restart device to apply changes."
                ;;
            "-gaming")
                set_config PERFORMANCE_PROFILE "gaming"
                echo "Gaming profile set. Restart device to apply changes."
                ;;
            "-multitask")
                set_config PERFORMANCE_PROFILE "multitasking"
                echo "Multitasking profile set. Restart device to apply changes."
                ;;
            "-auto")
                set_config PERFORMANCE_PROFILE "auto"
                echo "Auto profile detection enabled. Restart device to apply changes."
                ;;
            *)
                echo "ERROR: Usage: nextram -profile [-battery | -balanced | -performance | -gaming | -multitask | -auto]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-apps")
        case "$2" in
            "-perf")
                show_performance_apps
                ;;
            "-bg")
                show_background_apps
                ;;
            "-add")
                case "$3" in
                    "-perf")
                        if [ -n "$4" ]; then
                            add_performance_app "$4"
                        else
                            echo "ERROR: Usage: nextram -apps -add -perf <app>"
                            exit $MISSING_ARG
                        fi
                        ;;
                    "-bg")
                        if [ -n "$4" ]; then
                            add_background_app "$4"
                        else
                            echo "ERROR: Usage: nextram -apps -add -bg <app>"
                            exit $MISSING_ARG
                        fi
                        ;;
                    *)
                        echo "ERROR: Usage: nextram -apps -add [-perf | -bg] <app>"
                        exit $INVALID_ARG
                        ;;
                esac
                ;;
            "-remove")
                case "$3" in
                    "-perf")
                        if [ -n "$4" ]; then
                            remove_performance_app "$4"
                        else
                            echo "ERROR: Usage: nextram -apps -remove -perf <app>"
                            exit $MISSING_ARG
                        fi
                        ;;
                    "-bg")
                        if [ -n "$4" ]; then
                            remove_background_app "$4"
                        else
                            echo "ERROR: Usage: nextram -apps -remove -bg <app>"
                            exit $MISSING_ARG
                        fi
                        ;;
                    *)
                        echo "ERROR: Usage: nextram -apps -remove [-perf | -bg] <app>"
                        exit $INVALID_ARG
                        ;;
                esac
                ;;
            *)
                echo "ERROR: Usage: nextram -apps [-perf | -bg | -add | -remove]"
                exit $INVALID_ARG
                ;;
        esac
        ;;

    "-metrics")
        show_detailed_metrics
        ;;

    "-report")
        generate_metrics_report
        ;;

    "-log")
        show_log
        ;;

    "-help"|"")
        show_help
        ;;

    *)
        echo "ERROR: Unknown command: $1"
        show_help
        exit $INVALID_ARG
        ;;
esac

log_message "Command executed: $@"
exit $SUCCESS