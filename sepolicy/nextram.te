# NextRAM SELinux Policy
# Type definitions
type nextram, domain;
type nextram_exec, exec_type, file_type;

# Attribute declarations
attribute nextram_daemon;
attribute nextram_file;

# Domain transitions
init_daemon_domain(nextram)

# Type declarations for our executables
type main_nextram_service_daemon, nextram_exec, system_file_type;
type nextramd_zram_service, nextram_exec, system_file_type;
type nextramd_swap_service, nextram_exec, system_file_type;
type nextramd_kernel_tn_service, nextram_exec, system_file_type;
type nextramd_ctl_global, nextram_exec, system_file_type;

# File context associations
type_transition init nextram_exec:process nextram;

# Allow daemons to manage their own processes
allow nextram self:process {
    setsched setrlimit sigchld fork signal
    getsched getsession getpgid setpgid
    getcap setcap
};

allow nextram self:capability {
    sys_admin sys_resource sys_nice sys_ptrace
    sys_rawio sys_time kill chown fowner
    dac_override dac_read_search fsetid
};

allow nextram self:fd use;
allow nextram self:fifo_file rw_file_perms;
allow nextram self:unix_stream_socket { create connect accept listen };

# System file access
allow nextram system_file:file { execute execute_no_trans entrypoint };
allow nextram system_file:dir { search open getattr read };

# Data directory access for configs and logs
allow nextram system_data_file:dir {
    search write add_name remove_name setattr
    rmdir create reparent rename
};
allow nextram system_data_file:file {
    create read write open unlink getattr setattr
    append map lock ioctl
};

# Specific NextRAM data directories
type nextram_data_file, file_type, data_file_type, nextram_file;
allow nextram nextram_data_file:dir {
    search write add_name remove_name setattr
    rmdir create reparent rename
};
allow nextram nextram_data_file:file {
    create read write open unlink getattr setattr
    append map lock ioctl
};

# ZRAM device access
type zram_device, dev_type;
allow nextram zram_device:chr_file {
    open read write ioctl getattr setattr lock
    map append
};

# SysFS access for kernel parameters
allow nextram sysfs:filesystem getattr;
allow nextram sysfs:dir { search open getattr read };

allow nextram sysfs_vm:file {
    open read write getattr setattr lock map
    append ioctl
};

allow nextram sysfs_block:dir { search open getattr read };
allow nextram sysfs_zram:file {
    open read write getattr setattr lock map
    append ioctl
};

allow nextram sysfs_kernel:dir { search open getattr read };
allow nextram sysfs_kernel_slab:file {
    open read write getattr setattr
};

# ProcFS access for system monitoring
allow nextram proc:filesystem getattr;
allow nextram proc:dir { search open getattr read };

allow nextram proc_swaps:file { open read getattr map };
allow nextram proc_meminfo:file { open read getattr map };
allow nextram proc_vmstat:file { open read getattr map };
allow nextram proc_zoneinfo:file { open read getattr map };
allow nextram proc_pagetypeinfo:file { open read getattr map };

allow nextram proc_sys_vm:dir { search open getattr read };
allow nextram proc_sys_vm:file {
    open read write getattr setattr lock map
    append ioctl
};

# Kernel module operations
allow nextram system:module { load };
allow nextram kernel:system { module_request module_load };

# Thermal monitoring
allow nextram sysfs_thermal:dir { search open getattr read };
allow nextram sysfs_thermal:file {
    open read getattr map lock
};

# Network access for potential AI features and metrics
allow nextram node:udp_socket node_bind;
allow nextram port:udp_socket name_bind;
allow nextram netlink_route_socket:netlink_socket { create connect bind getattr setattr };
allow nextram netlink_kobject_uevent_socket:netlink_socket { create connect bind getattr setattr };

# IPC and signaling
allow nextram servicemanager:binder { call transfer };
allow nextram service_manager_type:service_manager find;

# Property service access
allow nextram property_socket:sock_file write;
allow nextram properties_device:dir search;
allow nextram properties_serial:property_service set;

# Specific NextRAM properties
type nextram_prop, property_type;
allow nextram nextram_prop:property_service { set get };

# Logging
allow nextram devpts:chr_file { open read write getattr ioctl };
allow nextram logd_socket:sock_file write;
allow nextram logd:unix_stream_socket connectto;

# Cgroup access for process management
allow nextram cgroup:dir { search open getattr read };
allow nextram cpuset:dir { search open getattr read write add_name remove_name };
allow nextram cpuset:file { open read write getattr setattr lock };

# Additional capabilities for advanced features
allow nextram self:capability2 { block_sustern syslog };
allow nextram kernel:system { syslog syslog_console syslog_mod };

# Debug and development
allow nextram debugfs:filesystem getattr;
allow nextram debugfs:dir { search open getattr read };
allow nextram tracing:dir { search open getattr read };

# Neverallow restrictions for security
neverallow { domain -nextram } nextram_data_file:file { create write setattr unlink };
neverallow { domain -nextram } nextram_prop:property_service set;
