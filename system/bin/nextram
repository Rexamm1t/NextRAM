                    set_config LOG_LEVEL "$2"
                    print_success "Log level set to $2. Restart device to apply changes."
                    ;;
                *)
                    print_error "Log level must be DEBUG, INFO, WARN, or ERROR"
                    exit $INVALID_VALUE
                    ;;
            esac
        else
            print_error "Usage: nextram -loglevel <DEBUG|INFO|WARN|ERROR>"
            exit $MISSING_ARG
        fi
