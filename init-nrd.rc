# NextRAM

service nextram-main /system/bin/main-nextram-service-daemon
    class main
    user root
    group root system
    seclabel u:r:nextram:s0
    capabilities SYS_ADMIN SYS_RESOURCE
    priority -10
    oom_score_adjust -1000
    writepid /dev/cpuset/system-background/tasks
    shutdown critical
    onrestart restart nextram-zram
    onrestart restart nextram-swap
    onrestart restart nextram-kernel

service nextram-zram /system/bin/nextramd-zram-service
    class main
    user root
    group root system
    seclabel u:r:nextram:s0
    capabilities SYS_ADMIN SYS_RESOURCE
    priority -5
    oom_score_adjust -900
    writepid /dev/cpuset/system-background/tasks

service nextram-swap /system/bin/nextramd-swap-service
    class main
    user root
    group root system
    seclabel u:r:nextram:s0
    capabilities SYS_ADMIN SYS_RESOURCE
    priority -5
    oom_score_adjust -900
    writepid /dev/cpuset/system-background/tasks

service nextram-kernel /system/bin/nextramd-kernel-tn-service
    class main
    user root
    group root system
    seclabel u:r:nextram:s0
    capabilities SYS_ADMIN SYS_RESOURCE
    priority -5
    oom_score_adjust -900
    writepid /dev/cpuset/system-background/tasks

service nextram-ctl /system/bin/nextramd-ctl-global
    class main
    user root
    group root system
    seclabel u:r:nextram:s0
    disabled
    oneshot

# Early-init phase - load ZRAM kernel module
on early-init
    exec -- /system/bin/sh -c "if [ -f /system/lib/modules/zram.ko ]; then insmod /system/lib/modules/zram.ko; fi"

# Create directories and set permissions after filesystem mount
on post-fs-data
    mkdir /data/adb/nextram 0755 root root
    mkdir /data/adb/nextram/logs 0755 root root
    mkdir /data/adb/nextram/cache 0755 root root
    mkdir /data/adb/nextram/reports 0755 root root
    chown root root /data/adb/nextram
    chmod 0755 /data/adb/nextram

    # Copy default config if not exists
    exec -- /system/bin/sh -c "if [ ! -f /data/adb/nextram/cfg-main.prop ]; then cp /system/etc/nextram/cfg-main.prop /data/adb/nextram/cfg-main.prop; fi"
    chown root root /data/adb/nextram/cfg-main.prop
    chmod 0644 /data/adb/nextram/cfg-main.prop

# Start main NextRAM service after boot complete
on property:sys.boot_completed=1
    start nextram-main
    start nextram-zram
    start nextram-swap
    start nextram-kernel
    start nextram-ctl

# Dynamic configuration reload via properties
on property:nextram.config.reload=1
    stop nextram-main
    stop nextram-zram
    stop nextram-swap
    stop nextram-kernel
    start nextram-main
    start nextram-zram
    start nextram-swap
    start nextram-kernel
    setprop nextram.config.reload 0

# Performance profiles switching
on property:nextram.profile=*
    exec -- /system/bin/nextramd-ctl-global -profile ${nextram.profile}

# ZRAM control
on property:nextram.zram.enable=*
    exec -- /system/bin/nextramd-ctl-global -zram ${nextram.zram.enable}

# Swap control
on property:nextram.swap.enable=*
    exec -- /system/bin/nextramd-ctl-global -swap ${nextram.swap.enable}

# Emergency stop on critical thermal events
on property:sys.thermal.temperature=*
    exec -- /system/bin/sh -c "if [ ${sys.thermal.temperature} -gt 80 ]; then setprop nextram.zram.enable false; setprop nextram.swap.enable false; fi"

# Service health monitoring triggers
on property:nextram.restart.zram=1
    stop nextram-zram
    start nextram-zram
    setprop nextram.restart.zram 0

on property:nextram.restart.swap=1
    stop nextram-swap
    start nextram-swap
    setprop nextram.restart.swap 0

on property:nextram.restart.kernel=1
    stop nextram-kernel
    start nextram-kernel
    setprop nextram.restart.kernel 0

# Log rotation trigger
on property:nextram.log.rotate=1
    exec -- /system/bin/sh -c "logrotate /system/etc/nextram/logrotate.conf"
    setprop nextram.log.rotate 0
