# NextRAM File Contexts

# Executables
/system/bin/main-nextram-service-daemon    u:object_r:main_nextram_service_daemon:s0
/system/bin/nextramd-zram-service          u:object_r:nextramd_zram_service:s0
/system/bin/nextramd-swap-service          u:object_r:nextramd_swap_service:s0
/system/bin/nextramd-kernel-tn-service     u:object_r:nextramd_kernel_tn_service:s0
/system/bin/nextramd-ctl-global            u:object_r:nextramd_ctl_global:s0

# Data directories
/data/adb/nextram                          u:object_r:nextram_data_file:s0
/data/adb/nextram/.*                       u:object_r:nextram_data_file:s0
/data/adb/nextram/logs/.*                  u:object_r:nextram_data_file:s0
/data/adb/nextram/cache/.*                 u:object_r:nextram_data_file:s0
/data/adb/nextram/reports/.*               u:object_r:nextram_data_file:s0

# Configuration files
/data/adb/nextram/cfg-main\.prop           u:object_r:nextram_data_file:s0
/system/etc/nextram/.*                     u:object_r:system_file:s0
